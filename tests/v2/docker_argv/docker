#!/usr/bin/env python3
"""A fake docker CLI: logs each argv as JSON to $FAKE_DOCKER_LOG and answers with fixed output."""
import os, sys, json
args = sys.argv[1:]
data = sys.stdin.buffer.read() if (args[:3] == ["cp", "-a", "-"] or args[:2] == ["exec", "-i"]) else b""
with open(os.environ["FAKE_DOCKER_LOG"], "a") as f:
    f.write(json.dumps([a if not a.startswith("/tmp/.corsair-exec-") else "<pidfile>" for a in args]) + (" stdin=%d" % len(data)) + "\n")
a = " ".join(args)
if args[:2] == ["image", "inspect"]:
    sys.stderr.write("Error: No such image\n"); sys.exit(1)
if args[0] == "inspect" and "{{.Id}}" in a:
    sys.stderr.write("Error: No such object\n"); sys.exit(1)
if args[0] == "inspect" and "{{.Image}}" in a:
    print("sha256:" + "a"*64); sys.exit(0)
if args[0] == "inspect" and "State.Running" in a:
    print("true"); sys.exit(0)
if args[0] == "exec" and "id -u; id -g" in a:
    print("10001\n10001"); sys.exit(0)
if args[0] == "exec" and "head -c" in a:
    print("start\nend\n---\nholds"); sys.exit(0)
if args[0] == "ps":
    print("corsair-v2-a\ncorsair-v2-b"); sys.exit(0)
if args[0] == "exec" and os.environ.get("FAKE_EXIT") and "pytest" in a:
    sys.exit(int(os.environ["FAKE_EXIT"]))
sys.exit(0)
