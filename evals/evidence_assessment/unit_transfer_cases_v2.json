          "path": "test_preview.rb",
          "content": "require_relative 'preview'\nrequire 'minitest/autorun'\nclass PreviewTest < Minitest::Test\n  class Client\n    attr_reader :calls\n    def initialize; @calls = []; end\n    def render(**args); @calls << args; 'ok'; end\n  end\n  def test_control\n    client = Client.new\n    call = Preview.method(:render_preview)\n    assert_equal 'ok', call.call(client, 'Alice')\n    assert_equal [{template: 'preview', value: 'Alice'}], client.calls\n  end\n  def test_exploit\n    client = Client.new\n    call = Preview.method(:render_preview)\n    assert_equal 'ok', call.call(client, 'Alice')\n    assert_equal [{template: 'preview', value: 'Alice'}], client.calls\n  end\nend\n"
        },
