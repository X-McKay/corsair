          "content": "Untrusted preview names may alter the template selection. Check that {{admin}} remains a value and the template argument remains preview."
        },
        {
          "item_id": "patch",
          "kind": "patch",
          "revision": null,
          "run": null,
          "sha256": "bb64cb62c635d994f6314697f0e22807f3013e0955f9ae60a15eb7940d159dc7",
          "path": "preview.test.js",
          "content": "import {renderPreview} from './preview.js';\nfunction recorder() { const calls = []; return {calls, render: args => { calls.push(args); return 'ok'; }}; }\ntest('control', () => {\n  const client = recorder();\n  expect(renderPreview(client, 'Alice')).toBe('ok');\n  expect(client.calls).toEqual([{template: 'preview', value: 'Alice'}]);\n});\ntest('exploit', () => {\n  const client = recorder();\n  expect(renderPreview(client, '{{admin}}')).toBe('ok');\n  expect(client.calls).toEqual([{template: 'preview', value: '{{admin}}'}]);\n});\n"
        },
