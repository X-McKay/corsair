      "sha256": "6e55282f15d14e355179573f3e0fae8bece468d6f0435db34dd9bc9eba1a896f",
      "content": "Exactly two Minitest probes in test/config_loader_test.rb. Control: ConfigLoader.load(\"name: demo\\n\") returns {\"name\" => \"demo\"}. Exploit: loading a document tagged !ruby/object:OpenStruct raises Psych::DisallowedClass. ConfigLoader.load in lib/config_loader.rb owns the permitted-class policy."
    },
    {
      "item_id": "reported-condition",
      "kind": "plan",
      "revision": null,
      "run": null,
      "sha256": "2d458c968e0f18a72e475670c0c304fef18b687ae4874785d22034ca56487d61",
      "content": "Imported project settings are read with ConfigLoader.load. A YAML document carrying a !ruby/object tag may instantiate arbitrary Ruby objects during import."
    },
    {
      "item_id": "baseline-source-0",
      "kind": "source",
      "revision": "baseline",
      "run": 0,
      "sha256": "6ba8c0478ad951f5257bf195b65c184d9008694f9790d3423cc5f59fc829bdba",
      "path": "lib/config_loader.rb",
      "source_sha256": "0beeed3f5be912ebdb04c6b26c4cff9659f14ca4ff3d8c07d53f5f9905863882",
      "content": "# frozen_string_literal: true\n\nrequire \"yaml\"\n\nmodule ConfigLoader\n  def self.load(text)\n    YAML.safe_load(text, permitted_classes: [Symbol], aliases: false)\n  end\nend\n"
    },
    {
      "item_id": "patch-0",
