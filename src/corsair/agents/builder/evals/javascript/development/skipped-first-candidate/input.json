    {
      "path": ".travis.yml",
      "content": "language: node_js\nnode_js:\n  - \"8\"\ninstall:\n  - npm ci --ignore-scripts\nscript:\n  - npm test\n"
    },
    {
      "path": "index.js",
      "content": "'use strict';\n\nfunction compare(a, b) {\n  return a.localeCompare(b, 'en', { numeric: true });\n}\n\nfunction caret(range, version) {\n  return version.split('.')[0] === range.replace('^', '').split('.')[0];\n}\n\nmodule.exports = { compare, caret };\n"
    },
    {
      "path": "package.json",
      "content": "{\n  \"name\": \"semver-range\",\n  \"version\": \"2.1.0\",\n  \"description\": \"semver-range utilities\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"jest\"\n  },\n  \"devDependencies\": {\n    \"jest\": \"24.9.0\"\n  },\n  \"license\": \"MIT\"\n}\n"
    },
    {
      "path": "test/caret.test.js",
      "content": "'use strict';\n\nconst target = require('../index');\n\ntest('matches caret ranges', () => {\n  expect(target.caret('^1.2.0', '1.9.0')).toBe(true);\n});\n"
    },
    {
      "path": "test/prerelease.test.js",
      "content": "'use strict';\n\nconst target = require('../index');\n\ntest('orders prerelease tags', () => {\n  expect(target.compare('1.0.0-alpha', '1.0.0-beta')).toBeLessThan(0);\n});\n\ntest.skip('handles build metadata', () => {\n  expect(target.compare('1.0.0+b1', '1.0.0+b2')).toBe(0);\n});\n"
    }
  ],
