{
  "name": "corsair-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test src/lib/*.test.ts",
    "e2e": "playwright test",
    "test:e2e": "tsc -p tsconfig.e2e.json && playwright test"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
